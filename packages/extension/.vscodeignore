# The VSIX should contain only the built bundle, the icon, and the manifest/readme/license.
.vscode/**
node_modules/**
src/**
.turbo/**
esbuild.config.mjs
tsconfig.json
vitest.config.ts
pnpm-lock.yaml
.env*
**/*.map
**/*.test.*
**/__tests__/**
*.vsix
# Working drafts are never release notes. A CHANGELOG.next.md once shipped inside the VSIX with
# unreleased copy and placeholder dates in it; the rule stays whether or not one exists today.
CHANGELOG*.md
!CHANGELOG.md
# Ship only the bundle from dist/ (excludes stale tsc output like index.js/index.d.ts).
dist/**
!dist/extension.js
